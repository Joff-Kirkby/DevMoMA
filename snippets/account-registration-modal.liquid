{% comment %}
  Account Registration Modal
{% endcomment %}

<aside class="ac-register__details-modal" id="acRegisterModal">
  <div class="modal__inner">
    <button type="button" class="modal__close ac-register__details-modal-close btn-icon" id="acRegisterModalClose">
      <span class="screenreader">Close</span>
      <i class="icon icon--close-white"></i>
    </button>
    <div>
      <ul class="ac-register__details-modal-list">
        <li>At least 8 characters in length</li>
        <li>Should contain:
          <ul>
            <li>lower case letters (a-z)</li>
            <li>upper case letters (A-Z)</li>
            <li>numbers (i.e. 0-9)</li>
          </ul>
      </ul>
    </div>
  </div>
</aside>
