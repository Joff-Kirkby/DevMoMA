<section class="rewards-hero container">
  <div class="rewards-hero__container">
    <div class="rewards-hero__left">
      <p class="rewards-hero__header">{{ section.settings.sub_heading_text | newline_to_br }}</p>
      <h1 class="rewards-hero__title">MoMA</h1>
      <h2 class="rewards-hero__sub-title">{{section.settings.heading_text }}</h2>
      <div class="rewards-hero__text-wrap">
        <h2 class="rewards-hero__text-wrap-title">{{section.settings.heading_text_2}}</h2>
        <div class="rewards-hero__img-blocks">
          {% render 'c-responsive-image', {
            image: section.settings.small_blocks,
            modifier: 'rewards-hero-img-small',
            image_class: 'rewards-hero__image-small',
          } %}
        </div>
      </div>
      <div class="rewards-hero__info">
        <p>
          {{ section.settings.body_text | newline_to_br }}
        </p>
      </div>
        <a class="rewards-hero__cta"
          href="{%- if customer -%}
                  {{- section.settings.cta_url_logged_in -}}
                {%- else -%}
                  {{- section.settings.cta_url -}}
                {%- endif -%}"
          >
          {{section.settings.cta_text}}
        </a>
    </div>

    <div class="rewards-hero__right">
      <div class="rewards-hero__right-image">
        {% render 'c-responsive-image', {
          image: section.settings.background_image_desktop,
          modifier: 'rewards-hero-img',
          wrapper_class: 'hide-mobile',
          image_class: 'rewards-hero__image',
        } %}

        {% if section.settings.background_image_mobile != blank %}
          {% render 'c-responsive-image', {
            image: section.settings.background_image_mobile,
            image_class: 'image-css-class',
            modifier: 'rewards-hero-img',
            wrapper_class: 'hide-desktop',
            inline_ir: true,
          } %}
        {% endif %}
      </div>
    </div>
  </div>
</section>
