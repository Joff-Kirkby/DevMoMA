{% comment %}
  variables set from parent snippet:
  product, namespace, has_variable_img_ratio
{% endcomment %}

{% comment %} set default variables {% endcomment %}
{% assign pi_has_more_colors = false %}
{% assign pi_tags = product.tags | join: ', ' %}

{% comment %} check if more then 1 color {% endcomment %}
{% for opt in product.options_with_values %}
  {% assign opt_name = opt.name | downcase %}
  {% if opt_name == 'color' %}
    {% for val in opt.values %}
      {% if forloop.length > 1 %}
        {% assign pi_has_more_colors = true %}
        {% break %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endfor %}

{% assign pi_card_url = product.url | within: collection | prepend: shop.url %}

<article class="{% render 'h-module', class: 'pi' %}">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "image": {{ product | image_url: width: 271 | json }},
    "url": {{ pi_card_url | json }},
    "offers": {
      "@type": "Offer",
      "priceCurrency": {{ shop.currency | json }},
      "price": {{ product.price | money_without_currency | strip_html | json }},
      {%- if product.available == true %}
      "availability": "https://schema.org/InStock",
      {%- elsif product.selected_or_first_available_variant.metafields.teamwork.po_date.value != blank %}
      "availability": "https://schema.org/BackOrder",
      {%- else %}
      "availability": "https://schema.org/OutOfStock",
      {%- endif %}
      "itemCondition": "https://schema.org/NewCondition"
    }
  }
  </script>

  <div class="pi__img">
    <a class="{% render 'h-module', class: 'pi__link' %} ir{% unless has_variable_img_ratio %} ir--product{% endunless %}" href="{{ product.url | within: collection }}">
      <img
        class="pi__image"
        src="{{ product | image_url: width: 285 }}"
        srcset="{{ product | image_url: width: 285 }} 1x, {{ product | image_url: width: 570 }} 2x"
        alt="{{ product.title | escape }}"
        loading="lazy"
      />
    </a>
  </div>

  <div class="{% render 'h-module', class: 'pi__desc' %}">

    <h3 class="{% render 'h-module', class: 'pi__title' %}">
      <a href="{{ product.url | within: collection }}">
        {{ product.title }}
      </a>
    </h3>

    <p class="pi__price">
      {% if product.price_min < product.price_max  %}
        {{ product.price_min | money }} - {{ product.price_max | money }}
      {% else %}
        {{ product.price | money }}
      {% endif %}
    </p>

  </div>

</article>
