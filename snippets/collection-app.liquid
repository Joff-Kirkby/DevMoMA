{% comment %}
  Collection App
  @param {Boolean} is_search
  @param {Object} section
{% endcomment %}

{%- liquid
  assign collection_hero = collection.metafields.collection.hero.value
  assign category_carousel = collection.metafields.collection.category_carousel.value
  assign sub_categories = collection.metafields.collection.sub_categories.value
  assign open_filter_by_default = collection.metafields.collection.open_filter_by_default.value
  assign desktop_navigation_meta = shop.metafields.navigation.desktop.value
  assign mobile_navigation_meta = shop.metafields.navigation.mobile.value
-%}
<h1 class="screenreader">{{ collection.title }}</h1>

{%- comment -%}
  Server-rendered first page: real product cards, pagination and filter
  links inside #collectionApp so non-JS crawlers see real content. The JS
  app still mounts into this same div for real visitors and overwrites it
  exactly as before this change - this is purely an additive SEO shell,
  not a replacement for the client-side experience.

  Card/pagination/filter classes are taken from the grid's real CSS
  (assets/collection.css.liquid: .collection-grid, .collection-grid-item,
  .collection-grid__pagination*, .collection-filters__*) - JS-only
  enhancements (badges, color swatches, quick-add, promotional messages)
  are intentionally not replicated here, since they aren't needed for
  crawler content and the JS app overwrites this shell on mount anyway.
{%- endcomment -%}
<div id="collectionApp" class="collection-wrapper">
  {%- if is_search -%}
    {%- paginate search.results by 50 -%}
      {%- render 'collection-grid-ssr', products: search.results, paginate: paginate, filters: search.filters -%}
    {%- endpaginate -%}
  {%- else -%}
    {%- paginate collection.products by 50 -%}
      {%- render 'collection-grid-ssr', products: collection.products, paginate: paginate, filters: collection.filters -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

<script>
  // disable browser scroll restoration for us to control later
  if (window.history.scrollRestoration) {
    window.history.scrollRestoration = 'manual';
  }

  SDG.Data.collectionMessages = {{ collection_messages | default: '[]' }} || [];
</script>

{%- capture collection_vars -%}
  <script>
    SDG.Data.contentBlocks = { blocks:[] };
    let block;
    {%- for block in section.blocks -%}
      {%- assign collection_handle = block.settings.collection_handle-%}
        block = {{ block.settings | json }};
        block.collection_id = {{ collections[collection_handle].id | json }};
        block.id = {{ block.settings.heading | json }};
        SDG.Data.contentBlocks.blocks.push(block);
    {%- endfor -%}
    {%- if is_search -%}
      SDG.Data.isSearch = true;
      SDG.Data.searchTerms = {{ search.terms | json }};
      SDG.Data.noResultsText = {{ section.settings.no_results_text | json }};
    {%- else -%}
      SDG.Data.collectionHero = {{ collection_hero | json }} || {};
      SDG.Data.collectionId = {{ collection.id | json }};
      SDG.Data.collectionHandle = {{ collection.handle | json }};
      SDG.Data.collectionTitle = {{ collection.title | json }};
      SDG.Data.desktopNavigationMeta = {{ desktop_navigation_meta | json }};
      SDG.Data.isSearch = false;
      SDG.Data.mobileNavigationMeta = {{ mobile_navigation_meta | json }};
      SDG.Data.products = {{ collection.products | json }};
      SDG.Data.mobileNav = {{ collection.metafields.collection.mobile_nav.value | json }};
      SDG.Data.subCategories = {% render 'collection-sub-categories-data', data: sub_categories %};
      SDG.Data.categoryCarousel = {% render 'category-carousel-data', data: category_carousel %};
      SDG.Data.openFiltersByDefault = {{ open_filter_by_default | json }};
      SDG.Data.scrollAnimation = {
        enabled: {{ section.settings.filters_with_animation | json }},
        duration: {{ section.settings.scroll_animation_duration | json }}
      };
      SDG.Data.copies = {
        recommendedProducts: {{ 'collections.filters.related_collections' | t | json }},
      }
    {%- endif -%}
  </script>
{%- endcapture -%}
{%- render 'h-minify', variable: collection_vars -%}

