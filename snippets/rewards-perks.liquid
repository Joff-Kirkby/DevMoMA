<div class="rewards-perks container">
  <div class="rewards-perks__inner-wrapper">
    <div class="carousel-wrapper">
      <h3 class="title">Perks Designed for You</h3>
      <div class="rewards-perks__carousel" data-flickity='{ "cellAlign": "left", "contain": true, "pageDots": false }'>
        <div class="perks-cell">
          <img class="icon icon--points-per-spent" alt="perks icon" src="https://cdn.shopify.com/s/files/1/0637/1360/7929/files/Perks_PointsPer_Spent.png?v=1666386606" />
          <h3>Points Per $ Spent</h3>
          <p>As you move up tiers, you’ll earn more points on each purchase.</p>
        </div>
        <div class="perks-cell">
          <img class="icon icon--birthday" alt="perks icon" src="https://cdn.shopify.com/s/files/1/0637/1360/7929/files/Perks_BirthdayBonus.png?v=1666386590" />
          <h3>Birthday Bonus</h3>
          <p>Let us know your birthday so we can send you surprise points.</p>
        </div>
        <div class="perks-cell">
          <img class="icon icon--purchase-bonus" alt="perks icon" src="https://cdn.shopify.com/s/files/1/0623/7962/2630/files/Perks_4thPurchaseBonus.png?v=1670880141" />
          <h3>4th Purchase Bonus</h3>
          <p>Make 4 purchases & receive 150 extra points.</p>
        </div>
        <div class="perks-cell">
          <img class="icon icon--early-access" alt="perks icon" src="https://cdn.shopify.com/s/files/1/0623/7962/2630/files/Perks_EarlyAccess.png?v=1670880141" />
          <h3>Early Access</h3>
          <p>Be the first to shop select new designs & sales.</p>
        </div>
        <div class="perks-cell">
          <img class="icon icon--invite-only" alt="perks icon" src="https://cdn.shopify.com/s/files/1/0623/7962/2630/files/Perks_Invite-OnlyEvents.png?v=1670880141" />
          <h3>Invite-Only Events</h3>
          <p>Ambassadors are invited to special store & museum events.</p>
        </div>
        <div class="perks-cell">
          <img class="icon icon--customer-service" alt="perks icon" src="https://cdn.shopify.com/s/files/1/0623/7962/2630/files/Perks_CustomerService.png?v=1670880141" />
          <h3>Priority Customer Service</h3>
          <p>Ambassadors receive extra attention with our customer service team.</p>
        </div>
      </div>
    </div>

    <table role="presentation" class="rewards-perks__table js-rewards-table" cellspacing="0">
      <tr class='reset'>
        <th scope="row" class="rewards-perks__table-th-program rewards-perks__table-th-program--overview rewards-perks__table-first-row-item">
          <div>Program Overview</div>
          <span class="rewards-perks__table-info">Full set of <a href="https://storehelpcenter.moma.org/hc/en-us/articles/11952851048077-Rewards-Terms-Conditions">Rewards Terms & Conditions</a> Apply</span>
        </th>
        <th scope="row" class="gray enthusiast">Enthusiast</th>
        <th scope="row" class="gray connoisseur">Connoisseur</th>
        <th scope="row" class="gray ambassador">Ambassador</th>
      </tr>
      <tr class="reset">
        <td class="rewards-perks__table-first-row-item">Shop to unlock</td>
        <td class="enthusiast">Free to Join!</td>
        <td class="connoisseur">$500 spend per year</td>
        <td class="ambassador">$1000+ spend per year</td>
      </tr>
      <tr>
        <td class="rewards-perks__table-first-row-item">Earn Points Per $ Spent</td>
        <td class="enthusiast">1x</td>
        <td class="connoisseur">1.5x</td>
        <td class="ambassador">2x</td>
      </tr>
      <tr>
        <td class="rewards-perks__table-first-row-item">Birthday Bonus</td>
        <td class="enthusiast">•</td>
        <td class="connoisseur">•</td>
        <td class="ambassador">•</td>
      </tr>
      <tr>
        <td class="rewards-perks__table-first-row-item">4th Purchase Bonus</td>
        <td class="enthusiast">•</td>
        <td class="connoisseur">•</td>
        <td class="ambassador">•</td>
      </tr>
      <tr>
        <td class="rewards-perks__table-first-row-item">Early Access to Select Designs and Promotions</td>
        <td class=""></td>
        <td class="connoisseur">•</td>
        <td class="ambassador">•</td>
      </tr>
      <tr>
        <td class="rewards-perks__table-first-row-item">Exclusive Bonus Points Days</td>
        <td></td>
        <td class="connoisseur">•</td>
        <td class="ambassador">•</td>
      </tr>
      <tr>
        <td class="rewards-perks__table-first-row-item">Invite Only Events</td>
        <td></td>
        <td></td>
        <td class="ambassador">•</td>
      </tr>
      <tr>
        <td class="rewards-perks__table-first-row-item">Priority Customer Service</td>
        <td></td>
        <td></td>
        <td class="ambassador">•</td>
      </tr>
    </table>
  </div>
    {%- comment -%}
      Yotpo Tiers widget
    {%- endcomment -%}
    <div class="yotpo-widget-instance" data-yotpo-instance-id="325460"></div>
</div>
