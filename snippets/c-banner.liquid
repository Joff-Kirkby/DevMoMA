{%- comment -%}
  Banner Section
{%- endcomment -%}

{% assign ss = section.settings %}

{% if ss.content_position_horizontal_desktop == 'left' %}
  {% assign left = '0' %}
  {% assign right = 'unset' %}
{% endif %}

{% if ss.content_position_horizontal_desktop == 'center' %}
  {% assign left = '33%' %}
  {% assign right = 'unset' %}
{% endif %}

{% if ss.content_position_horizontal_desktop == 'right' %}
  {% assign left = 'unset' %}
  {% assign right = '0' %}
{% endif %}

{% assign hex_to_rgba = ss.image_overlay_color | hex_to_rgba: ss.image_overlay_opacity %}

<section
  class="banner{% if ss.is_page_hero %} banner--hero{% endif %} container"
  id="section-{{ section.id }}"
  style="
    --mobile-stack-color: {{ ss.mobile_stack_color }};
    --content-position-vertical-mobile: {{ ss.content_position_vertical_mobile }};
    --content-position-vertical-desktop: {{ ss.content_position_vertical_desktop }};
    --content-position-horizontal-desktop-left: {{ left }};
    --content-position-horizontal-desktop-right: {{ right }};
    --sub-heading-position-mobile: {{ ss.sub_heading_position_mobile }};
    --sub-heading-position-desktop: {{ ss.sub_heading_position_desktop }};
    --heading-position-mobile: {{ ss.heading_position_mobile }};
    --heading-position-desktop: {{ ss.heading_position_desktop }};
    --body-text-position-mobile: {{ ss.body_text_position_mobile }};
    --body-text-position-desktop: {{ ss.body_text_position_desktop }};
    --body-max-width: {{ ss.body_max_width }}{{ ss.max_width_unit }};
    --cta-position-mobile: {{ ss.cta_position_mobile }};
    --cta-position-desktop: {{ ss.cta_position_desktop }};
    {%- comment -%} CTA Primary {%- endcomment -%}
    --cta-static-text-color: {{ ss.cta_static_text_color }};
    --cta-static-bg-color: {% if ss.static_cta_style == 'transparent_background' %}transparent{% else %}{{ ss.cta_static_background_color }}{% endif %};
    --cta-static-border-color: {% if ss.static_cta_style == 'transparent_background' %}{{ ss.cta_static_text_color }}{% else %}{{ ss.cta_static_background_color }}{% endif %};
    --cta-hover-text-color: {{ ss.cta_hover_text_color }};
    --cta-hover-bg-color: {% if ss.hover_cta_style == 'transparent_background' %}transparent{% else %}{{ ss.cta_hover_background_color }}{% endif %};
    --cta-hover-border-color: {% if ss.hover_cta_style == 'transparent_background' %}{{ ss.cta_hover_text_color }}{% else %}{{ ss.cta_hover_background_color }}{% endif %};
    {%- comment -%} CTA Secondary {%- endcomment -%}
    --cta-static-text-color-2: {{ ss.cta_static_text_color_2 }};
    --cta-static-bg-color-2: {% if ss.static_cta_style_2 == 'transparent_background' %}transparent{% else %}{{ ss.cta_static_background_color_2 }}{% endif %};
    --cta-static-border-color-2: {% if ss.static_cta_style_2 == 'transparent_background' %}{{ ss.cta_static_text_color_2 }}{% else %}{{ ss.cta_static_background_color_2 }}{% endif %};
    --cta-hover-text-color-2: {{ ss.cta_hover_text_color_2 }};
    --cta-hover-bg-color-2: {% if ss.hover_cta_style_2 == 'transparent_background' %}transparent{% else %}{{ ss.cta_hover_background_color_2 }}{% endif %};
    --cta-hover-border-color-2: {% if ss.hover_cta_style_2 == 'transparent_background' %}{{ ss.cta_hover_text_color_2 }}{% else %}{{ ss.cta_hover_background_color_2 }}{% endif %};
  "
>
  <div class="banner__item{% if ss.mobile_stack %} banner__item--stack{% endif %}">
    {% if ss.link_wrapper != blank %}
    <a class="banner__link-wrapper" href="{{ ss.link_wrapper }}" aria-label="{{ ss.screen_reader_text | append: ' read more' }}" ></a>
    {% endif %}
    <div class="banner__item-image">
      {% render 'image',
        class: "width-full",
        lazy: false,
        image: ss.background_image_desktop,
        image_width: 1920,
        tablet_image: ss.background_image_tablet,
        tablet_image_width: 768,
        mobile_image: ss.background_image_mobile,
        mobile_image_width: 640
      %}
    </div>
    <div class="banner__item-content{% if ss.mobile_stack %} banner__item-content--stack{% endif %}">
      <div class="banner__item-content__header-container">
        {% if ss.sub_heading_text != blank %}
          <div class="banner__item-content__sub-heading" style="color: {{ ss.sub_heading_color }};">
            <p>{{ ss.sub_heading_text | newline_to_br }}</p>
          </div>
        {% endif %}
        {% if ss.heading_text != blank %}
          <div class="banner__item-content__heading" style="color: {{ ss.heading_color }};">
            <p>{{ ss.heading_text | newline_to_br }}</p>
          </div>
        {% endif %}
      </div>
      {% if ss.body_text != blank %}
        <div class="banner__item-content__body-text" style="color: {{ ss.body_text_color }};">
          <p>{{ ss.body_text | newline_to_br }}</p>
        </div>
      {% endif %}
      {% if ss.cta_text != blank %}
        <div class="banner__item-content__cta-wrapper">
          <div>
            <a
              href="{{ ss.cta_url }}"
              class="banner__item-content__cta banner__item-content__cta--primary"
            >
              <span>
                {{ ss.cta_text }}
              </span>
            </a>
          </div>
          {% if ss.secondary_cta != blank %}
            <div>
              <a
                href="{{ ss.cta_url_2 }}"
                class="banner__item-content__cta banner__item-content__cta--secondary"
              >
                <span>
                  {{ ss.cta_text_2 }}
                </span>
              </a>
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #section-{{ section.id }} .banner__item::before {
    background-color: {{ hex_to_rgba }};
  }
</style>
