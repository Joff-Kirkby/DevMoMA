{% comment %}
  Membership Benefits Modal
  @param {string} description
{% endcomment %}

<aside class="membership-benefits-modal modal" id="membershipBenefitsModal">
  <div class="modal__inner">
    <button type="button" class="modal__close btn-icon js-modal-close" id="membershipBenefitsModalClose">
      <span class="screenreader">Close</span>
      <i class="icon icon--close"></i>
    </button>
    <div class="modal__inner-body">
      <h2 class="modal__inner-heading"></h2>
      <div class="modal__inner-text"></div>
    </div>
  </div>
</aside>
<div id="membershipBenefitsModalOverlay" class="modal-overlay"></div>
