<section class="find-store container">
  <div class="find-store__inner-wrapper">
    <div class="find-store__header">
      <h2 class="find-store__heading">Here's How to Redeem Your Coupon In Store</h2>
    </div>

    <div class="find-store__step find-store__step--1">
      <span class="find-store__number find-store__number--1">
        <span class="screenreader">Step</span>1
      </span>
      <div class="find-store__content-wrapper">
        <div class="find-store__desc">Visit a MoMA Design Store location</div>
      </div>
    </div>
    <div class="find-store__step find-store__step--2">
      <span class="find-store__number find-store__number--2">
        <span class="screenreader">Step</span>2
      </span>
      <div class="find-store__content-wrapper">
        <div class="find-store__desc">Find something nice to purchase</div>
      </div>
    </div>
    <div class="find-store__step find-store__step--3">
      <span class="find-store__number find-store__number--3">
        <span class="screenreader">Step</span>3
      </span>
      <div class="find-store__content-wrapper">
        <div class="find-store__desc">When you are ready to check-out give the store associate the coupon code & your email address</div>
      </div>
    </div>
    <div class="find-store__step find-store__step--4">
      <span class="find-store__number find-store__number--4">
        <span class="screenreader">Step</span>4
      </span>
      <div class="find-store__content-wrapper">
        <div class="find-store__desc">Not in store? Don't worry, your coupon will be saved in Rewards History in <a href="{% render 'h-auth0-url' %}">your account</a>.</div>
      </div>
    </div>

    <div class="find-store__button-wrapper">
      <a class="find-store__button" href="https://store.moma.org/pages/stores">Find a Store Near You</a>
    </div>
  </div>
</section>
