{%- comment -%}
  Dependencies:
  - Lazysizes plugin (https://github.com/aFarkas/lazysizes) which enable responsive image with faster load time and better performance.
  - Lazysizes Responsive Images as a Service (https://github.com/aFarkas/lazysizes/tree/gh-pages/plugins/rias) To load the correct image size with Shopify's CDN

  Params:
  - image {Object} Image object
  - image_class {String} class name of the <img />
  - image_alt {String} alt text of the <img />
  - image_attributes {String} additional HTML attributes of the <img>
  - inline_ir {Boolean} if true, an inline style will output the ir dynamically
  - modifier {String} ir modifier class
  - wrapper_class {String} class name of the <div> wrapper
  - link {String} URL for the wrapping tag, if used wraping elemnt be an 'a' tag
  - flickity_lazyload: {Boolean} if true, it will add the flickity lazyload attribute
  - decorative {Boolean} if true, renders an empty alt (for images inside labeled controls)

  Usage:
  - In your liquid template file, copy the following lines:
    {% render 'c-responsive-image', {
      image: featured_image,
      image_class: 'image-css-class',
      modifier: 'modifier-css-class',
      wrapper_class: 'wrapper-css-class',
    } %}
{%- endcomment -%}

{%- assign img_url = image | img_url: '1x1' | replace: '_1x1.', '_{width}x.' -%}
{%- if decorative -%}
  {%- assign img_alt = '' -%}
{%- else -%}
  {%- assign img_alt = image_alt | default: image.alt | escape -%}
{%- endif -%}

{%- comment -%} Limit image widths to valid options based on image.width {%- endcomment -%}
{%- assign image_widths = '180,360,540,720,900,1080,1296,1512,1728,1944,2160,2376,2592,2808,3024' | split: ',' -%}
{%- capture image_widths -%}
  {%- for width in image_widths -%}
    {%- comment -%} Check if image width is less or equal to width {%- endcomment -%}
    {%- assign width_num = width | plus: 0 | round -%}
    {%- if image.width > width_num -%}{{ width_num }},{%- endif -%}
  {%- endfor -%}
  {{ image.width }}
{%- endcapture -%}
{%- assign image_widths = image_widths | strip -%}

{%- assign flickity_lazyload_attr = '' -%}
{%- if flickity_lazyload -%}
  {%- comment -%}
    In order to trigger a lazyLoad event from flickity
    there needs to be a src set from data-flickity-lazyload-src
    I didn't want to double load another image since lazysizes is handling all
    that so we are using a very small inline image to trigger the flickity
    lazyLoad event and in turn I can trigger the lazySizes lazy load using js
    (currently only being triggered in product-gallery.js)
    tiny image reference: https://stackoverflow.com/a/13139830
  {%- endcomment -%}
  {%- assign flickity_lazyload_attr = 'data-flickity-lazyload-src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"' -%}
{%- endif -%}

{%- assign wrapping_tag = 'div' -%}
{%- if link -%}
  {%- assign wrapping_tag = 'a' -%}
{%- endif -%}

<{{ wrapping_tag }}
  class="ir{% if modifier %} ir--{{ modifier }}{% endif %} is-loading {{ wrapper_class }}"
  {% if inline_ir %}{% render 'h-intrinsic-ratio', image: image %}{% endif %}
  {% if link %}
    href="{{ link }}"
  {% endif %}
>
  <img
    class="lazyload {{ image_class }}"
    data-src="{{ img_url }}"
    data-widths="[{{ image_widths }}]"
    data-sizes="auto"
    tabindex="-1"
    {{- flickity_lazyload_attr -}}
    alt="{{ img_alt }}"
    {{ image_attributes }}
  >
</{{ wrapping_tag }}>
