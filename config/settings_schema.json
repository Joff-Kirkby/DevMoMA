[
  {
    "name": "theme_info",
    "theme_name": "MoMA",
    "theme_author": "Domaine",
    "theme_version": "1.31.2",
    "theme_documentation_url": "https://meetdomaine.com/",
    "theme_support_url": "https://meetdomaine.com/"
  },
  {
    "name": "Development Environment",
    "settings": [
      {
        "type": "header",
        "content": "Choose an environment"
      },
      {
        "type": "select",
        "id": "env",
        "label": "Development Environment",
        "options": [
          {
            "value": "staging",
            "label": "Staging"
          },
          {
            "value": "production",
            "label": "Production"
          }
        ],
        "default": "production"
      },
      {
        "type": "checkbox",
        "id": "env_enable_js_minify",
        "label": "Enable JS Minification",
        "default": true
      }
    ]
  },
  {
    "name": "BOPIS API URL (Optional)",
    "settings": [
      {
        "type": "text",
        "id": "bopis_api_url",
        "label": "BOPIS API URL (Optional)",
        "info": "If left blank, the BOPIS API will be set to moma-order-history.netlify.app"
      }
    ]
  },
  {
    "name": "Sentry",
    "settings": [
      {
        "type": "text",
        "id": "sentry_loader_key",
        "label": "Sentry Loader Script key",
        "info": "Public key from the project's Loader Script URL (js.sentry-cdn.com/<key>.min.js). Leave blank to use the built-in default key."
      },
      {
        "type": "range",
        "id": "sentry_sample_rate_percent",
        "label": "Sentry sampling rate",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 5,
        "info": "Share of error events sent to Sentry. 0 sends nothing, 100 sends everything. Themes without a saved value use 5%."
      },
      {
        "type": "textarea",
        "id": "sentry_ignored_resources",
        "label": "Ignored resource URLs",
        "default": "bat.bing.com/*\n*.smarterhq.io/*\nfonts.googleapis.com/*\nfonts.gstatic.com/*\n*.google-analytics.com/*\n*.googletagmanager.com/*\n*.doubleclick.net/*\nconnect.facebook.net/*",
        "info": "Images, scripts and stylesheets whose load failures are never reported to Sentry. One pattern per line, matched against the URL without protocol and query string; * matches any characters. Example: cdn.shopify.com/extensions/*. Themes without a saved value use the default list."
      }
    ]
  },
  {
