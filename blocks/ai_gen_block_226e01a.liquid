{% doc %}
  @prompt
    i need a custom liquid block to paste a code snippet in
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-liquid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding }}px;
  }

  .ai-custom-liquid-container-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-custom-liquid-empty-state-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    border: 2px dashed #cccccc;
    border-radius: 8px;
    padding: 40px 20px;
    text-align: center;
    color: #666666;
  }

  .ai-custom-liquid-empty-state-{{ ai_gen_id }} h3 {
    margin: 0 0 8px;
    font-size: 18px;
    color: #333333;
  }

  .ai-custom-liquid-empty-state-{{ ai_gen_id }} p {
    margin: 0;
    font-size: 14px;
  }
{% endstyle %}

<div class="ai-custom-liquid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-custom-liquid-container-{{ ai_gen_id }}">
    {% if block.settings.custom_liquid != blank %}
      {{ block.settings.custom_liquid }}
    {% else %}
      <div class="ai-custom-liquid-empty-state-{{ ai_gen_id }}">
        <h3>Custom Liquid Block</h3>
        <p>Add your custom Liquid code in the block settings to get started</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Custom liquid",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom Liquid code"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Custom liquid"
    }
  ]
}
{% endschema %}
