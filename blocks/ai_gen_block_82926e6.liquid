{% doc %}
  @prompt
    please create an FAQ section that I can customize the font size and add URLs. please allow me to be able to add as many FAQs as needed. Base the styling and font off the site font., Base the design, font size and color based off the rest of the site, match the font to what is used on the site., please allow me to customize the padding around the FAQ section on both desktop and mobile, please ensure the font of the answers is the same as the questions, can you make the open and close experience smoother? right now it feels a bit clunky, can you add a line border in between the FAQs, Can you left align the header, allow me to customize the font size of the question and the answer
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-section-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding_top_desktop }}px {{ block.settings.padding_horizontal_desktop }}px {{ block.settings.padding_bottom_desktop }}px {{ block.settings.padding_horizontal_desktop }}px;
    font-family: 'Open Sans', sans-serif;
  }

  .ai-faq-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_font_size }}px;
    margin-bottom: 30px;
    text-align: left;
    color: {{ block.settings.heading_color }};
    font-family: 'Open Sans', sans-serif;
  }

  .ai-faq-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-faq-item-{{ ai_gen_id }} {
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .ai-faq-item-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-faq-question-button-{{ ai_gen_id }} {
    width: 100%;
    padding: 20px 0;
    background-color: {{ block.settings.question_bg_color }};
    border: none;
    text-align: left;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    transition: background-color 0.25s ease;
    font-family: 'Open Sans', sans-serif;
  }

  .ai-faq-question-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.question_hover_bg_color }};
  }

  .ai-faq-question-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.question_font_size }}px;
    color: {{ block.settings.question_text_color }};
    font-weight: 600;
    flex-grow: 1;
    font-family: 'Open Sans', sans-serif;
  }

  .ai-faq-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    color: {{ block.settings.icon_color }};
  }

  .ai-faq-item-{{ ai_gen_id }}.active .ai-faq-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-faq-answer-wrapper-{{ ai_gen_id }} {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ai-faq-item-{{ ai_gen_id }}.active .ai-faq-answer-wrapper-{{ ai_gen_id }} {
    grid-template-rows: 1fr;
  }

  .ai-faq-answer-inner-{{ ai_gen_id }} {
    overflow: hidden;
  }

  .ai-faq-answer-content-{{ ai_gen_id }} {
    padding: 0 0 20px 0;
    background-color: {{ block.settings.answer_bg_color }};
  }

  .ai-faq-answer-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.answer_font_size }}px;
    color: {{ block.settings.answer_text_color }};
    line-height: 1.6;
    font-family: 'Open Sans', sans-serif;
    font-weight: 400;
  }

  .ai-faq-answer-text-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-faq-answer-text-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-faq-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_horizontal_mobile }}px {{ block.settings.padding_bottom_mobile }}px {{ block.settings.padding_horizontal_mobile }}px;
    }

    .ai-faq-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_font_size }}px * 0.8);
    }

    .ai-faq-question-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.question_font_size }}px * 0.9);
    }

    .ai-faq-answer-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.answer_font_size }}px * 0.9);
    }
  }
{% endstyle %}

