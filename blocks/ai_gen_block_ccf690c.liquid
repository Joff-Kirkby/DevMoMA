{% doc %}
  @prompt
    please create an FAQ section that I can customize the font size and add URLs. please allow me to be able to add as many FAQs as needed. Base the styling and font off the site font. , give me the ability to adjust the padding on the sides on both desktop and mobile
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-section-{{ ai_gen_id }} {
    display: block !important;
    width: {{ block.settings.desktop_width_percent }}% !important;
    max-width: 1360px !important; /* 1280px content width + 80px total padding buffer */
    margin-left: auto !important;
    margin-right: auto !important;
    padding-top: 40px !important;
    padding-bottom: 40px !important;
    padding-left: {{ block.settings.desktop_side_padding }}px !important;
    padding-right: {{ block.settings.desktop_side_padding }}px !important;
    box-sizing: border-box !important;
  }

  .ai-faq-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_font_size }}px;
    margin-bottom: 30px;
    text-align: {{ block.settings.heading_alignment }};
    color: {{ block.settings.heading_color }};
  }

  .ai-faq-item-{{ ai_gen_id }} {
    border-bottom: 1px solid {{ block.settings.divider_color }};
    margin-bottom: 0;
  }

  .ai-faq-question-{{ ai_gen_id }} {
    width: 100%;
    background: none;
    border: none;
    padding: {{ block.settings.question_padding }}px 40px {{ block.settings.question_padding }}px 0;
    text-align: left;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: {{ block.settings.question_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.question_color }};
    position: relative;
  }

  .ai-faq-question-{{ ai_gen_id }}:hover {
    color: {{ block.settings.question_hover_color }};
  }

  .ai-faq-icon-{{ ai_gen_id }} {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 24px;
    height: 24px;
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }

  .ai-faq-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.icon_color }};
  }

  .ai-faq-question-{{ ai_gen_id }}[aria-expanded="true"] .ai-faq-icon-{{ ai_gen_id }} {
    transform: translateY(-50%) rotate(180deg);
  }

  .ai-faq-answer-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-faq-answer-content-{{ ai_gen_id }} {
    padding: 0 0 {{ block.settings.answer_padding }}px 0;
    font-size: {{ block.settings.answer_font_size }}px;
    line-height: 1.6;
    color: {{ block.settings.answer_color }};
  }

  .ai-faq-answer-content-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-faq-answer-content-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-faq-section-{{ ai_gen_id }} {
      padding-left: {{ block.settings.mobile_side_padding }}px !important;
      padding-right: {{ block.settings.mobile_side_padding }}px !important;
    }
  }
{% endstyle %}

