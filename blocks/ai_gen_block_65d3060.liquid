{% doc %}
  Full-Width Video Section
  - Heights: 600px (Desktop), 330px (Mobile)
  - Uses Shopify video_url input type
{% enddoc %}

{% style %}
  .full-width-video-{{ section.id }} {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    height: 600px;
    background-color: #000000;
    overflow: hidden;
  }

  .full-width-video__container-{{ section.id }} {
    width: 100%;
    height: 100%;
    position: relative;
  }

  /* Cover Overlay Styles */
  .full-width-video__cover-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #000000;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .full-width-video__cover-img-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .full-width-video__play-btn-{{ section.id }} {
    position: relative;
    z-index: 3;
    width: 80px;
    height: 80px;
    background-color: rgba(255, 255, 255, 0.95);
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
    transition: transform 0.25s ease, background-color 0.2s ease;
  }

  .full-width-video__cover-{{ section.id }}:hover .full-width-video__play-btn-{{ section.id }} {
    transform: scale(1.1);
    background-color: #ffffff;
  }

  .full-width-video__play-btn-{{ section.id }} svg {
    width: 28px;
    height: 28px;
    fill: #000000;
    margin-left: 4px;
  }

  .full-width-video__iframe-{{ section.id }} {
    width: 100%;
    height: 100%;
    border: none;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
  }

  /* Hidden Cover when Video Plays */
  .full-width-video__container-{{ section.id }}.is-playing .full-width-video__cover-{{ section.id }} {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .full-width-video-{{ section.id }} {
      height: 330px;
    }

    .full-width-video__play-btn-{{ section.id }} {
      width: 60px;
      height: 60px;
    }

    .full-width-video__play-btn-{{ section.id }} svg {
      width: 20px;
      height: 20px;
    }
  }
{% endstyle %}

{% comment %} Handle YouTube ID extraction reliably {% endcomment %}
{% assign raw_video_id = section.settings.video.id %}
{% if raw_video_id == blank %}
  {% assign raw_video_id = section.settings.video | split: 'v=' | last | split: '&' | first %}
{% endif %}
{% assign cover_class = 'full-width-video__cover-img-' | append: section.id %}

<div class="full-width-video-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="full-width-video__container-{{ section.id }}" id="VideoContainer-{{ section.id }}">
    
    {% comment %} Cover Image Container {% endcomment %}
    <div class="full-width-video__cover-{{ section.id }}" id="VideoCover-{{ section.id }}">
      
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1920 | image_tag: 
          class: cover_class,
          loading: 'eager',
          alt: section.settings.image.alt | default: 'Video Cover Image'
        }}
      {% elsif raw_video_id != blank %}
        <img 
          src="https://img.youtube.com/vi/{{ raw_video_id }}/maxresdefault.jpg" 
          class="{{ cover_class }}" 
          alt="Video Thumbnail"
          loading="eager"
        >
      {% endif %}

      <button class="full-width-video__play-btn-{{ section.id }}" type="button" aria-label="Play Video">
        <svg viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </button>
    </div>

    {% comment %} Video Embed {% endcomment %}
    {% if raw_video_id != blank %}
      <iframe 
        id="VideoIframe-{{ section.id }}"
        class="full-width-video__iframe-{{ section.id }}"
        src="https://www.youtube-nocookie.com/embed/{{ raw_video_id }}?enablejsapi=1&rel=0"
        data-autoplay-src="https://www.youtube-nocookie.com/embed/{{ raw_video_id }}?autoplay=1&enablejsapi=1&rel=0"
        title="YouTube Video Player"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    {% endif %}

  </div>
</div>

<script>
  (function() {
    const setupVideo = function() {
      const container = document.getElementById('VideoContainer-{{ section.id }}');
      const cover = document.getElementById('VideoCover-{{ section.id }}');
      const iframe = document.getElementById('VideoIframe-{{ section.id }}');

      if (cover && iframe) {
        cover.addEventListener('click', function() {
          const autoplaySrc = iframe.getAttribute('data-autoplay-src');
          if (autoplaySrc) {
            iframe.src = autoplaySrc;
          }
          container.classList.add('is-playing');
        });
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupVideo);
    } else {
      setupVideo();
    }
  })();
</script>

{% schema %}
{
  "name": "Full Width Video",
  "settings": [
    {
      "type": "header",
      "content": "Media Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom Cover Image",
      "info": "Format: JPG. Recommended width: 1920px;"
    },
    {
      "type": "video_url",
      "id": "video",
      "label": "YouTube Video URL",
      "accept": [
        "youtube"
      ],
      "default": "https://www.youtube.com/watch?v=ulavsai42XI"
    }
  ],
  "presets": [
    {
      "name": "Full Width Video"
    }
  ]
}
{% endschema %}