<!doctype html>
<html lang="en-US">
<head>
  {% comment %} Meta Data {% endcomment %}
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>
    {{ 'general.password_page.login_form_password_label' | t }}{% if current_tags %}{% assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: tags: meta_tags }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
  </title>
  <meta name="description" content="{{ shop.name | escape }}">

  {% comment %} Social Meta {% endcomment %}
  {% render 'social-meta-tags' %}

  {% comment %} Favicons {% endcomment %}
  {% render 'favicons' %}

  {% comment %} Helpers {% endcomment %}
  <link rel="canonical" href="{{ canonical_url }}">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {% comment %} CSS {% endcomment %}
  <link href="https://fonts.googleapis.com/css?family=Open+Sans" rel="stylesheet">
  {{ 'password.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}
</head>
<body id="page-password" class="{% if customer %}customer-logged-in {% endif %}template-{{ template | replace: '.', ' ' | truncatewords: 1, '' | handle }}">
  {{ content_for_layout }}
</body>
</html>
