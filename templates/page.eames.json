"disabled":true,"settings":{"background_image_desktop":"shopify:\/\/shop_images\/EO_Design_0825_FW.gif","background_image_tablet":"shopify:\/\/shop_images\/EO_Design_0825_FW.gif","content_position_horizontal_desktop":"left","content_position_vertical_mobile":"start","sub_heading_text":"","sub_heading_position_desktop":"left","sub_heading_position_mobile":"left","sub_heading_color":"#000000","heading_text":"","heading_position_desktop":"left","heading_position_mobile":"left","heading_color":"#000000","body_text":"","body_text_position_desktop":"left","body_text_position_mobile":"left","body_text_color":"#000000","cta_text":"","cta_url":"https:\/\/moma-design-store.myshopify.com","cta_position_desktop":"left","cta_position_mobile":"left","cta_type":"static","cta_static_background_color":"#ffffff","cta_static_text_color":"#000000","hover_cta_style":"transparent_background","cta_hover_is_transparent":false,"cta_hover_border_color":"#000000","cta_hover_background_color":"#ffffff","cta_hover_text_color":"#000000","sub_text":"","sub_text_link":""}},"category-collections":{"type":"category-collections","disabled":true,"settings":{"mobile_block_type":"stacked","header_1":"","subheader_1":"","cta_text_1":"","cta_link_1":"","header_2":"","subheader_2":"","cta_text_2":"","cta_link_2":""}},"video-highlight":{"type":"video-highlight","disabled":true,"settings":{"video":"","heading_text":"Heading text here","body_text":"Body text here","cta_text":"Default CTA text","cta_url":""}},"166011968972f1315f":{"type":"banner","settings":{"is_page_hero":true,"background_image_desktop":"shopify:\/\/shop_images\/cre_landing_hero.jpg","background_image_mobile":"shopify:\/\/shop_images\/cre_landing_hero_m.jpg","image_overlay_color":"#000000","image_overlay_opacity":0,"link_wrapper":"","mobile_stack":false,"mobile_stack_color":"#ffffff","content_position_horizontal_desktop":"left","content_position_vertical_desktop":"start","content_position_vertical_mobile":"start","sub_heading_text":"","screen_reader_text":"Sub-Heading text here","sub_heading_position_desktop":"left","sub_heading_position_mobile":"left","sub_heading_color":"#000000","heading_text":"Charles and Ray Eames\nat MoMA","heading_position_desktop":"left","heading_position_mobile":"left","heading_color":"#ffffff","body_text":"","body_text_position_desktop":"left","body_text_position_mobile":"left","body_text_color":"#000000","body_max_width":200,"max_width_unit":"%","cta_text":"","cta_url":"","cta_position_desktop":"left","cta_position_mobile":"left","static_cta_style":"solid_background","cta_static_background_color":"#ffffff","cta_static_text_color":"#000000","hover_cta_style":"transparent_background","cta_hover_background_color":"#ffffff","cta_hover_text_color":"#000000","secondary_cta":false,"cta_text_2":"Default CTA text","cta_url_2":"","static_cta_style_2":"solid_background","cta_static_background_color_2":"#ffffff","cta_static_text_color_2":"#000000","hover_cta_style_2":"transparent_background","cta_hover_background_color_2":"#ffffff","cta_hover_text_color_2":"#000000"}},"16601198980ba905d3":{"type":"quote-and-image","settings":{"text":"<p>Since 1929, MoMA has sought to find designers and artists whose work is original and long-lasting in its influence—true pioneers who can combine a love of design with practicality and innovation. The husband and wife design team of Charles and Ray Eames defines this combination.<\/p><p>“The details are not the details. They make the design.”—Charles Eames<\/p>","image":"shopify:\/\/shop_images\/cre_charlesPortrait.jpg","image_position":"right"}},"16601199249c3ddee8":{"type":"two-up-and-text","settings":{"headline":"A Storied Relationship","text_block_alignment":"right","text":"<p>The Museum of Modern Art’s history with the Eameses goes back to their very early days. At the beginning of their careers, they traveled on different paths: Charles had an architectural background and Ray studied painting; they met while both studying at Cranbrook School of Art in Michigan. During the course of his studies there, Charles and his colleague, architect Eero Saarinen, collaborated on a series of experimental molded plywood chairs, which won the Museum’s \"Organic Design in Home Furnishings Competition\" in 1940.<br\/><br\/>After this initial success, the next year Charles and Ray married and moved to Los Angeles, where they continued their experiments with molded plywood. Together, the designer couple would go on to show their work in a number of subsequent MoMA design exhibitions and competitions in the 1940s and ‘50s.<\/p>","cta_text":"","cta_url":"https:\/\/moma-design-store.myshopify.com\/","static_cta_style":"solid_background","cta_static_background_color":"#000000","cta_static_text_color":"#ffffff","hover_cta_style":"transparent_background","cta_hover_background_color":"#ffffff","cta_hover_text_color":"#000000","anchor":"","image":"shopify:\/\/shop_images\/cre_storiedRelationship-1.png","image_2":"shopify:\/\/shop_images\/cre_storiedRelationship-2.png"}},"16601199826f275c63":{"type":"wide-image-and-text","settings":{"headline_text_alignment_desktop":"left","headline_text_alignment_mobile":"left","eyebrow":"","headline":"Charles and Rayat MoMA","text_copy_alignment_desktop":"left","text_copy_alignment_mobile":"left","text":"<p>Charles (1907–1978) and Ray (1912–1988) Eames became two of the most influential designers of the 20th century, and their groundbreaking work has appeared in dozens of exhibitions at The Museum of Modern Art. The work of this husband-and-wife team has been featured in such MoMA shows as <em>New Furniture Designs by Charles Eames <\/em>(1946), <em>International Competition for Low Cost Furniture <\/em>(1950), the Good Design exhibition series (1950-1955), and, more recently, <em>Plywood: Material, Process, Form <\/em>(2011–2013) and <em>The Value of Good Design <\/em>(2019).<\/p>","cta_text_alignment_desktop":"left","cta_text_alignment_mobile":"left","cta_text":"","cta_url":"","anchor":"","custom_cta_styles":false,"cta_background_color":"#000000","cta_text_color":"#ffffff","cta_border_color":"#000000","cta_hover_background_color":"#ffffff","cta_hover_text_color":"#000000","cta_hover_border_color":"#000000","image":"shopify:\/\/shop_images\/cre_couplePortrait.jpg","video":"","image_position":"right"}},"1660120014be786832":{"type":"two-up-and-text","settings":{"headline":"Material Innovators","text_block_alignment":"right","text":"<p>One of the Eameses’ most famous innovations was their experimentation with the evolving craft of molding plywood. Their experiments were so groundbreaking that during World War II, the United States Navy commissioned them to produce molded plywood splints, stretchers and experimental glider shells.<br\/><br\/>They created a <a href=\"https:\/\/www.moma.org\/collection\/works\/2116\"><span style=\"text-decoration:underline\">wafer-thin glider nose<\/span><\/a> as a study in aerodynamic precision, leveraging their new ability to create multidimensional curves in wood. After the War, Charles and Ray adapted these body-hugging, biomorphic forms for their furniture designs. Their sense of design was exceptional: Their original molded plywood chair, the <a href=\"https:\/\/www.moma.org\/collection\/works\/2111\"><span style=\"text-decoration:underline\">LCW<\/span><\/a>, was called “the chair of the century” by the influential architectural critic Esther McCoy.<\/p>","cta_text":"","cta_url":"","static_cta_style":"solid_background","cta_static_background_color":"#ffffff","cta_static_text_color":"#000000","hover_cta_style":"transparent_background","cta_hover_background_color":"#ffffff","cta_hover_text_color":"#000000","anchor":"","image":"shopify:\/\/shop_images\/cre_storiedRelationship-1_aca038a2-b805-49fc-9389-13b09ee793f2.png","image_2":"shopify:\/\/shop_images\/cre_storiedRelationship-2_dd383227-f9f0-41c7-b786-b280f931d657.png"}},"16601200531d0803b9":{"type":"wide-image-and-text","settings":{"headline_text_alignment_desktop":"left","headline_text_alignment_mobile":"left","eyebrow":"","headline":"The Eames® Hang-It-All Coat Rack","text_copy_alignment_desktop":"left","text_copy_alignment_mobile":"left","text":"<p>Before the arrival of the Eameses’ whimsical Hang-It-All in 1953, coat racks were mostly a humdrum affair. Evoking the era’s Atomic Age atom models, the design’s 14 colorful balls seem suspended in air. Ray Eames applied this playful sense of color in a sophisticated reinterpretation of a conventional coat rack. The Hang-It-All uses the same wire welding techniques the Eameses developed for manufacturing their wire chairs and table bases. The Hang-It-All Coat Rack, an object in the Museum’s collection, was featured in MoMA's 2012 exhibition <em>Century of the Child: Growing by Design, 1900-2000 <\/em>and is an authorized product manufactured by Herman Miller®.<\/p>","cta_text_alignment_desktop":"left","cta_text_alignment_mobile":"left","cta_text":"Shop Eames® Hang-It-All","cta_url":"https:\/\/store.moma.org\/products\/eames%C2%AE-hang-it-all-coat-rack","anchor":"","custom_cta_styles":false,"cta_background_color":"#000000","cta_text_color":"#ffffff","cta_border_color":"#000000","cta_hover_background_color":"#ffffff","cta_hover_text_color":"#000000","cta_hover_border_color":"#000000","image":"shopify:\/\/shop_images\/cre_hangItAll.jpg","video":"","image_position":"right"}},"1660120059b8d6d3be":{"type":"wide-image-and-text","settings":{"headline_text_alignment_desktop":"left","headline_text_alignment_mobile":"left","eyebrow":"","headline":"The Eames® Lounge Chair with Ottoman™","text_copy_alignment_desktop":"left","text_copy_alignment_mobile":"left","text":"<p>When Charles and Ray Eames first conceived this design, they wanted to create a chair that was comfortable. It has since become a statement chair, a piece of art that is as comfortable as it is beautiful. The second Eames® Lounge Chair and Ottoman to come from the production line was given as a gift to film director Billy Wilder, a frequent collaborator of Charles and Ray Eames.<\/p>","cta_text_alignment_desktop":"left","cta_text_alignment_mobile":"left","cta_text":"Shop the Eames® Lounge Chair with Ottoman™","cta_url":"shopify:\/\/products\/eames-lounge-chair-and-ottoman-old","anchor":"","custom_cta_styles":false,"cta_background_color":"#000000","cta_text_color":"#ffffff","cta_border_color":"#000000","cta_hover_background_color":"#ffffff","cta_hover_text_color":"#000000","cta_hover_border_color":"#000000","image":"shopify:\/\/shop_images\/Artboard_5b72814f-bdeb-4a13-9827-b01b433f6f57.jpg","video":"","image_position":"left"}},"1660939774b7a41f50":{"type":"section-spacer","settings":{"section_spacer_mobile_size":0,"section_spacer_desktop_size":0}},"79b05725-c1f2-45ba-bee2-c526b84ff60e":{"type":"product-carousel","blocks":{"product_UBcm9K":{"type":"product","disabled":true,"settings":{"product":"eames-r-b-stools-from-herman-miller-c-walnut"}},"product_P7NWii":{"type":"product","disabled":true,"settings":{"product":"eames-two-seat-sofa-from-herman-miller-2-seat"}},"product_aXaFgT":{"type":"product","disabled":true,"settings":{"product":"eames-house-of-cards-deck-small"}},"product_zCJXNp":{"type":"product","disabled":true,"settings":{"product":"eames-pacific-palisades-coffee-table"}},"product_3y9iqL":{"type":"product","disabled":true,"settings":{"product":"eames-house-bird-ash-black"}},"product_qMXqx6":{"type":"product","disabled":true,"settings":{"product":"ec127-eames-recycled-plastic-dining-chair-from-herman-miller-black-black"}},"product_xjjcwr":{"type":"product","disabled":true,"settings":{"product":"eames-desk-from-herman-miller-black-white"}}},"block_order":["product_UBcm9K","product_P7NWii","product_aXaFgT","product_zCJXNp","product_3y9iqL","product_qMXqx6","product_xjjcwr"],"settings":{"limit":16,"searchspring_tag":"ray-and-charles-eames-at-moma","layout":"header_top_cta_bottom","heading_alignment_desktop":"center","heading_alignment_mobile":"center","heading_text":"You May Also Like","cta_text"