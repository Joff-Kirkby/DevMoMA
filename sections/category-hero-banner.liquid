{%- comment -%}
  Category Hero Banner
{%- endcomment -%}

{% assign ss = section.settings %}

{% if ss.hover_cta_style == 'transparent_background' %}
  {% assign hover_text_color = '#000' %}
  {% assign hover_background_color = 'transparent' %}
{% endif %}

{% if ss.hover_cta_style == 'black_background' %}
  {% assign hover_text_color = '#FFF' %}
  {% assign hover_background_color = '#000' %}
{% endif %}

{% if ss.content_position_horizontal_desktop == 'left' %}
  {% assign left = '0' %}
  {% assign right = 'unset' %}
{% endif %}

{% if ss.content_position_horizontal_desktop == 'center' %}
{% assign left = '33%' %}
{% assign right = 'unset' %}
{% endif %}

{% if ss.content_position_horizontal_desktop == 'right' %}
{% assign left = 'unset' %}
{% assign right = '0' %}
{% endif %}

<section class="category-hero-banner container">
  {% style %}
    .category-hero-banner__item-content__cta.category-hero-banner__item-content__cta--hover p:hover,
    .category-hero-banner__item-content__cta.category-hero-banner__item-content__cta--hover p:focus {
      color: {{ hover_text_color }} !important;
      background-color: {{ hover_background_color }} !important;
      outline: 2px solid #000 !important;
    }

    .category-hero-banner__item-content__cta--hover p {
      color: {{ ss.cta_hover_text_color }};
      background-color:{% if ss.cta_hover_is_transparent %} transparent{% else %} {{ ss.cta_hover_background_color }}{% endif %};
      border: 2px solid {{ ss.cta_hover_border_color }};
    }

    @media only screen and (max-width: 1024px) {
      .category-hero-banner__item-content {
        justify-content: {{ ss.content_position_vertical_mobile }};
      }

      .category-hero-banner__item-content__sub-heading {
        text-align: {{ ss.sub_heading_position_mobile }};
      }

      .category-hero-banner__item-content__heading {
        text-align: {{ ss.heading_position_mobile }};
      }

      .category-hero-banner__item-content__body-text {
        text-align: {{ ss.body_text_position_mobile }};
      }

      .category-hero-banner__item-content__cta {
        text-align: {{ ss.cta_position_mobile }};
      }
    }

    @media only screen and (min-width: 1025px) {
      .category-hero-banner__item-content {
        left: {{ left }};
        right: {{ right }};
      }

      .category-hero-banner__item-content__sub-heading {
        text-align: {{ ss.sub_heading_position_desktop }};
      }

      .category-hero-banner__item-content__heading {
        text-align: {{ ss.heading_position_desktop }};
      }

      .category-hero-banner__item-content__body-text {
        text-align: {{ ss.body_text_position_desktop }};
      }

      .category-hero-banner__item-content__cta {
        text-align: {{ ss.cta_position_desktop }};
      }
    }
  {% endstyle %}

  <div class="category-hero-banner__item">
    <div class="category-hero-banner__item-image">
      {% if ss.background_image_desktop != blank %}
        {% render 'c-responsive-image', {
          image: ss.background_image_desktop,
          modifier: 'category-hero-banner',
          wrapper_class: 'desktop-only',
        } %}
      {% endif %}

      {% if ss.background_image_tablet != blank %}
        {% render 'c-responsive-image', {
          image: ss.background_image_tablet,
          modifier: 'category-hero-banner',
          wrapper_class: 'tablet-only',
        } %}
      {% endif %}

      {% if ss.background_image_mobile != blank %}
        {% render 'c-responsive-image', {
          image: ss.background_image_mobile,
          modifier: 'category-hero-banner',
          wrapper_class: 'phone-only',
        } %}
      {% endif %}
    </div>
    <div class="category-hero-banner__item-content">
      <div class="category-hero-banner__item-content__header-container">
        {% if ss.sub_heading_text != blank %}
          <div class="category-hero-banner__item-content__sub-heading" style="color: {{ ss.sub_heading_color }};">
            <p>{{ ss.sub_heading_text | newline_to_br }}</p>
          </div>
        {% endif %}
        {% if ss.heading_text != blank %}
          <div class="category-hero-banner__item-content__heading" style="color: {{ ss.heading_color }};">
            <h1 class="category-hero-banner__heading">{{ ss.heading_text | newline_to_br }}</h1>
          </div>
        {% endif %}
      </div>
      {% if ss.body_text != blank %}
        <div class="category-hero-banner__item-content__body-text" style="color: {{ ss.body_text_color }};">
          <p class="category-hero-banner__description">{{ ss.body_text | newline_to_br }}</p>
        </div>
      {% endif %}
      {% if ss.cta_text != blank %}
        <a
          href="{{ ss.cta_url }}"
          class="category-hero-banner__item-content__cta{% if ss.cta_type == 'static' %} category-hero-banner__item-content__cta--static{% endif %}{% if ss.cta_type == 'hover' %} category-hero-banner__item-content__cta--hover{% endif %}"
        >
          <p
            {% if ss.cta_type == 'static' %}style="color: {{ ss.cta_static_text_color }}; background-color: {{ ss.cta_static_background_color }};"{% endif %}
          >
            {{ ss.cta_text }}
          </p>
        </a>
      {% endif %}
    </div>
    {% if ss.sub_text != blank %}
      <small class="category-hero-banner__sub-text">
        <a href="{{ ss.sub_text_link }}">
          {{ ss.sub_text }}
        </a>
      </small>
    {% endif %}
  </div>
</section>

