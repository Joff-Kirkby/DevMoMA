{%- comment -%}
  Banner Section
{%- endcomment -%}

{%- render 'c-rewards-hero', {
  section: section
} -%}

{% schema %}
  {
    "name": "Rewards Hero",
    "settings": [
      {
        "type": "image_picker",
        "id": "background_image_desktop",
        "label": "Background Image (Desktop)",
        "info": "Format: JPG or GIF. Recommended dimensions: width: 3840px; height: 1371px;"
      },
      {
        "type": "image_picker",
        "id": "background_image_mobile",
        "label": "Background Image (Mobile)",
        "info": "Format: JPG or GIF. Recommended dimensions: width: 750px; height: 1075px;"
      },
      {
        "type": "image_picker",
        "id": "small_blocks",
        "label": "Small Blocks",
        "info": "Format: JPG or GIF. Recommended dimensions: width: 100px; height: 100px;"
      },
      {
        "type": "textarea",
        "id": "sub_heading_text",
        "label": "Sub-Heading Text",
        "default": "Sub-Heading text here",
        "info": "Descriptive keyword or phrase placed above the main heading. Return/enter can be used to create line breaks in content."
      },
      {
        "type": "textarea",
        "id": "heading_text",
        "label": "Heading Text",
        "default": "Design Store",
        "info": "Return/enter can be used to create line breaks in content."
      },
      {
        "type": "textarea",
        "id": "heading_text_2",
        "label": "Heading Text line 2",
        "default": "Rewards",
        "info": "Return/enter can be used to create line breaks in content."
      },
      {
        "type": "textarea",
        "id": "body_text",
        "label": "Body Text",
        "default": "Body text here",
        "info": "Return/enter can be used to create line breaks in content."
      },
      {
        "type": "text",
        "id": "cta_text",
        "label": "CTA Text",
        "default": "Sign in or create an account"
      },
      {
        "type": "header",
        "content": "CTA (Logged In)"
      },
      {
        "type": "text",
        "id": "cta_url_logged_in",
        "label": "CTA URL",
        "default": "https://moma-design-store.myshopify.com/pages/rewards"
      },
      {
        "type": "header",
        "content": "CTA (Logged Out)"
      },
      {
        "type": "text",
        "id": "cta_url",
        "label": "CTA URL",
        "default": "https://moma-design-store.myshopify.com/account"
      }
    ],
    "presets": [
      {
        "name": "Rewards Hero"
      }
    ]
  }
{% endschema %}
