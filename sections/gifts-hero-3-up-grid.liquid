{%- comment -%}
  Gifts Hero Grid
{%- endcomment -%}
{% assign ss = section.settings %}
<div class="gifts-hero-grid" style="margin-top: {{ ss.section_top_margin }}px; margin-bottom: {{ ss.section_bottom_margin }}px;">

  <div class="gifts-hero-grid__hero" style="background-color: var(--main-hero-bg-color);">
    {%- if ss.main_hero_cta_url != blank -%}
      <a href="{{ ss.main_hero_cta_url }}" class="gifts-hero-grid__hero-link">
    {%- endif -%}
    {% if ss.main_hero_background_image_desktop != blank %}
      {% render 'c-responsive-image', {
        image: ss.main_hero_background_image_desktop,
        image_class: 'gifts-hero-grid__hero-image--desktop',
        wrapper_class: 'gifts-hero-grid__hero-image-wrapper desktop-only',
        inline_ir: false,
      } %}
    {% endif %}
    {% if ss.main_hero_background_image_tablet != blank %}
      {% render 'c-responsive-image', {
        image: ss.main_hero_background_image_tablet,
        image_class: 'gifts-hero-grid__hero-image--tablet',
        wrapper_class: 'gifts-hero-grid__hero-image-wrapper tablet-only',
        inline_ir: false,
      } %}
    {% endif %}
    {% if ss.main_hero_background_image_mobile != blank %}
      {% render 'c-responsive-image', {
        image: ss.main_hero_background_image_mobile,
        image_class: 'gifts-hero-grid__hero-image--mobile',
        wrapper_class: 'gifts-hero-grid__hero-image-wrapper phone-only',
        inline_ir: false,
      } %}
    {% endif %}
  <div class="gifts-hero-grid__hero-copy"  style="color: {{ ss.main_hero_heading_color }};">
    {% if ss.main_hero_heading_text != blank %}
      <div class="gifts-hero-grid__hero-copy--heading">
        <h2>{{ ss.main_hero_heading_text | newline_to_br }}</h2>
      </div>
    {% endif %}
    {% if ss.main_hero_body_text != blank %}
      <div class="gifts-hero-grid__hero-copy--body">
        <p>{{ ss.main_hero_body_text | newline_to_br }}</p>
      </div>
    {% endif %}
    {% if ss.main_hero_cta_text != blank %}
      <div class="gifts-hero-grid__hero-copy--cta">
        <div class="btn btn--primary">
          {{ ss.main_hero_cta_text }}
        </div>
      </div>
    {% endif %}
  </div>
  {%- if ss.main_hero_cta_url != blank -%}
  </a>
  {%- endif -%}
</div>
<div class="gifts-hero-grid__finder" style="background-color: var(--finder-bg-color)">
  {%- if ss.finder_cta_url != blank -%}
    <a href="{{ ss.finder_cta_url }}" class="full-width-url">
  {%- endif -%}
  {% if ss.finder_background_image_desktop != blank %}
    {% render 'c-responsive-image', {
      image: ss.finder_background_image_desktop,
      image_class: 'gifts-hero-grid__finder-image--desktop',
      wrapper_class: 'gifts-hero-grid__finder-image-wrapper hide-mobile',
      inline_ir: false,
    } %}
  {%- endif -%}
  {% if ss.finder_background_image_mobile != blank %}
    {% render 'c-responsive-image', {
      image: ss.finder_background_image_mobile,
      image_class: 'gifts-hero-grid__finder-image--mobile',
      wrapper_class: 'gifts-hero-grid__finder-image-wrapper hide-desktop',
      inline_ir: false,
    } %}
  {%- endif -%}

  <div class="gifts-hero-grid__finder-copy">
    {% if ss.finder_heading_text != blank %}
      <div class="gifts-hero-grid__finder-copy--heading" style="color: {{ ss.finder_heading_color }};">
        {{ ss.finder_heading_text | newline_to_br }}
      </div>
    {% endif %}
    {% if ss.finder_body_text != blank %}
      <div class="gifts-hero-grid__finder-copy--body hide-mobile" style="color: {{ ss.finder_body_text_color }};">
        {{ ss.finder_body_text | newline_to_br }}
      </div>
    {% endif %}
    {% if ss.finder_cta_text != blank %}
      <div class="gifts-hero-grid__finder-copy--cta" style="color: {{ ss.finder_cta_static_text_color }};">
        {{ ss.finder_cta_text }}
      </div>
    {% endif %}
  </div>
  {%- if ss.finder_cta_url != blank -%}
  </a>
  {%- endif -%}
</div>
<div class="gifts-hero-grid__gift-card" style="background-color: var(--finder-bg-color-secondary)">
  {%- if ss.finder_cta_url_secondary != blank -%}
    <a href="{{ ss.finder_cta_url_secondary }}" class="full-width-url">
  {%- endif -%}
  {% if ss.finder_background_image_desktop_secondary != blank %}
    {% render 'c-responsive-image', {
      image: ss.finder_background_image_desktop_secondary,
      image_class: 'gifts-hero-grid__gift-card-image--desktop',
      wrapper_class: 'gifts-hero-grid__gift-card-image-wrapper',
    } %}
  {%- endif -%}
  <div class="gifts-hero-grid__gift-card-copy">
    {% if ss.finder_heading_text_secondary != blank %}
      <div class="gifts-hero-grid__gift-card-copy--heading" style="color: {{ ss.finder_heading_color_secondary }};">
        {{ ss.finder_heading_text_secondary | newline_to_br }}
      </div>
    {% endif %}
    {% if ss.finder_body_text_secondary != blank %}
      <div class="gifts-hero-grid__gift-card-copy--body" style="color: {{ ss.finder_body_text_color_secondary }};">
        {{ ss.finder_body_text_secondary | newline_to_br }}
      </div>
    {% endif %}
    {% if ss.finder_cta_text_secondary != blank %}
      <div class="gifts-hero-grid__gift-card-copy--cta">
        {{ ss.finder_cta_text_secondary }}
      </div>
    {% endif %}
  </div>
  {%- if ss.finder_cta_url_secondary != blank -%}
    </a>
  {%- endif -%}
</div>
  {% for block in section.blocks %}
    {% assign bs = block.settings %}
    <div class="gifts-hero-grid__block gifts-hero-grid__block-{{forloop.index}}" style="color: {{ bs.text_color }}; background-color: {{ bs.bg_color}}">
      {% if bs.url != blank %}
        <a href="{{ bs.url }}" style="color: {{ bs.text_color }}">
      {% endif %}
      <div> {{ bs.title }}</div>
      {% if bs.url != blank %}
      </a>
      {% endif %}
    </div>
  {% endfor %}

  <style>
    .gifts-hero-grid {
      --main-hero-bg-color: {% if ss.main_hero_background_image_mobile != blank %}transparent{% else %}{{ ss.main_hero_background_color | default: 'transparent' }}{% endif %};
      --finder-bg-color: {% if ss.finder_background_image_mobile != blank %}transparent{% else %}{{ ss.finder_background_color | default: 'transparent' }}{% endif %};
      --finder-bg-color-secondary: {% if ss.finder_background_image_desktop_secondary != blank %}transparent{% else %}{{ ss.finder_background_color_secondary | default: 'transparent' }}{% endif %};
    }

    .gifts-hero-grid__hero-copy--cta .btn.btn--primary {
      color: {{ ss.main_hero_cta_static_text_color }};
      background-color: {{ ss.main_hero_cta_static_background_color }};
    }
    .gifts-hero-grid__hero-copy--cta .btn.btn--primary:hover {
      color: {{ ss.main_hero_cta_hover_text_color }};
      background-color: {{ ss.main_hero_cta_hover_background_color }};
    }
  </style>
</div>

