            "id": "logo",
            "label": "Logo",
            "info": "Format: PNG, JPG. Recommended dimensions: width: 560px; height: 280px;"
          },
          {
            "type": "textarea",
            "id": "sub_heading_text",
            "label": "Sub-Heading Text",
