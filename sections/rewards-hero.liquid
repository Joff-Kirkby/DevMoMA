{% for block in section.blocks %}
  {% assign bs = block.settings %}
  {% if block.type == 'logged_out' %}
    {% unless customer %}
      {% render 'c-rewards-hero-2', bs: bs %}
    {% endunless %}
  {% elsif block.type == 'logged_in' %}
    {% if customer %}
      {% render 'c-rewards-hero-2', bs: bs %}
    {% endif %}
  {% endif %}
{% endfor %}

{% schema %}
  {
    "name": "Rewards Hero 2",
    "settings": [],
    "max_blocks": 2,
    "blocks": [
      {
        "name": "Logged out view",
        "type": "logged_out",
        "limit": 1,
        "settings": [
          {
            "type": "image_picker",
            "id": "background_image_desktop",
            "label": "Background Image (Desktop)",
            "info": "Format: JPG or GIF. Recommended dimensions: width: 3840px; height: 1371px;"
          },
          {
            "type": "image_picker",
            "id": "background_image_mobile",
            "label": "Background Image (Mobile)",
            "info": "Format: JPG or GIF. Recommended dimensions: width: 750px; height: 1075px;"
