{%- comment -%}
  Gifts Hero Banner Section
{%- endcomment -%}

<div class="gifts-hero-banner">
  {%- render 'c-gifts-hero-banner', {
    section: section
  } -%}
</div>
<div class="gifts-finder-banner">
