            "type": "color",
            "id": "background_color",
            "label": "Background Color",
            "default": "#000000"
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Text Color",
            "default": "#ffffff"
          },
          {
            "type": "select",
            "id": "text_alignment",
            "label": "Text Alignment",
            "options": [
              {
                "value": "left",
                "label": "Left"
              },
              {
                "value": "center",
                "label": "Center"
              },
              {
                "value": "right",
                "label": "Right"
              }
            ],
            "default": "left"
          },
          {
            "type": "textarea",
            "id": "text",
            "label": "Text",
            "default": "Gifts $25 And Under"
          },
          {
            "type": "url",
            "id": "url",
            "label": "Block URL Link"
          }
        ]
      },
      {
        "name": "Large Image",
        "type": "large_image",
        "settings": [
          {
            "type": "image_picker",
