            "id": "text_alignment",
            "label": "Text Alignment",
            "options": [
              {
                "value": "left",
                "label": "Left"
              },
              {
                "value": "center",
                "label": "Center"
              },
              {
                "value": "right",
                "label": "Right"
              }
            ],
            "default": "left"
          },
          {
            "type": "text",
            "id": "text",
            "label": "Text",
            "default": "Gift Category"
          },
          {
            "type": "url",
            "id": "url",
            "label": "Block URL Link"
          }
        ]
      }
    ],
    "presets": [
