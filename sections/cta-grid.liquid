          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "center"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "The Gift Store"
      }
    ],
    "blocks": [
      {
        "name": "Text",
        "type": "text",
        "settings": [
