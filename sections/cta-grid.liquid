            "label": "Image",
            "info": "Recommended: Size: 1220x948px; Format: JPG"
          },
          {
            "type": "color",
            "id": "text_color",
            "label": "Text Color",
            "default": "#000000"
          },
          {
            "type": "select",
            "id": "text_alignment",
            "label": "Text Alignment",
            "options": [
              {
                "value": "left",
                "label": "Left"
              },
              {
                "value": "center",
                "label": "Center"
              },
              {
                "value": "right",
                "label": "Right"
              }
            ],
            "default": "left"
          },
          {
            "type": "text",
            "id": "text",
            "label": "Text",
            "default": "Bestselling Gifts"
          },
          {
            "type": "url",
            "id": "url",
            "label": "Block URL Link"
          }
        ]
      },
      {
        "name": "Small Image",
        "type": "small_image",
        "settings": [
          {
            "type": "image_picker",
