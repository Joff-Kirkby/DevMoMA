{%- comment -%}
  Banner Carousel Section
{%- endcomment -%}

{% assign autoplay_delay = section.settings.autoplay_delay %}
<swiper-container
  class="banner-carousel-container"
  slides-per-view="1"
  loop="true"
  navigation="true"
  pagination="true"
  auto-height="true"
  {% if autoplay_delay != 0 %}
    autoplay-delay="{{ autoplay_delay | times: 1000 }}"
  {% endif %}
  style="--swiper-pagination-bullet-inactive-opacity: 0.61;"
>
  {% for block in section.blocks %}
    {% assign bs = block.settings %}

    {% assign hex_to_rgba = bs.image_overlay_color | hex_to_rgba: bs.image_overlay_opacity %}
    <swiper-slide {{ block.shopify_attributes }}>
      <div
        class="banner{% if bs.is_page_hero %} banner--hero{% endif %}"
        id="block-{{ block.id }}"
        style="
          --mobile-stack-color: {{ bs.mobile_stack_color }};
          --content-position-vertical-mobile: {{ bs.content_position_vertical_mobile }};
          --content-position-vertical-desktop: {{ bs.content_position_vertical_desktop }};
          --sub-heading-position-mobile: {{ bs.sub_heading_position_mobile }};
          --sub-heading-position-desktop: {{ bs.sub_heading_position_desktop }};
          --heading-position-mobile: {{ bs.heading_position_mobile }};
          --heading-position-desktop: {{ bs.heading_position_desktop }};
          --body-text-position-mobile: {{ bs.body_text_position_mobile }};
          --body-text-position-desktop: {{ bs.body_text_position_desktop }};
          --body-max-width: {{ bs.body_max_width }}{{ bs.max_width_unit }};
          --cta-position-mobile: {{ bs.cta_position_mobile }};
          --cta-position-desktop: {{ bs.cta_position_desktop }};
        {%- comment -%} CTA Primary {%- endcomment -%}
          --cta-static-text-color: {{ bs.cta_static_text_color }};
          --cta-static-bg-color: {% if bs.static_cta_style == 'transparent_background' %}transparent{% else %}{{ bs.cta_static_background_color }}{% endif %};
          --cta-static-border-color: {% if bs.static_cta_style == 'transparent_background' %}{{ bs.cta_static_text_color }}{% else %}{{ bs.cta_static_background_color }}{% endif %};
          --cta-hover-text-color: {{ bs.cta_hover_text_color }};
          --cta-hover-bg-color: {% if bs.hover_cta_style == 'transparent_background' %}transparent{% else %}{{ bs.cta_hover_background_color }}{% endif %};
          --cta-hover-border-color: {% if bs.hover_cta_style == 'transparent_background' %}{{ bs.cta_hover_text_color }}{% else %}{{ bs.cta_hover_background_color }}{% endif %};
        {%- comment -%} CTA Secondary {%- endcomment -%}
          --cta-static-text-color-2: {{ bs.cta_static_text_color_2 }};
          --cta-static-bg-color-2: {% if bs.static_cta_style_2 == 'transparent_background' %}transparent{% else %}{{ bs.cta_static_background_color_2 }}{% endif %};
          --cta-static-border-color-2: {% if bs.static_cta_style_2 == 'transparent_background' %}{{ bs.cta_static_text_color_2 }}{% else %}{{ bs.cta_static_background_color_2 }}{% endif %};
          --cta-hover-text-color-2: {{ bs.cta_hover_text_color_2 }};
          --cta-hover-bg-color-2: {% if bs.hover_cta_style_2 == 'transparent_background' %}transparent{% else %}{{ bs.cta_hover_background_color_2 }}{% endif %};
          --cta-hover-border-color-2: {% if bs.hover_cta_style_2 == 'transparent_background' %}{{ bs.cta_hover_text_color_2 }}{% else %}{{ bs.cta_hover_background_color_2 }}{% endif %};
          "
      >
        <div class="banner__item{% if bs.mobile_stack %} banner__item--stack{% endif %}">
          {% if bs.link_wrapper != blank %}
            <a class="banner__link-wrapper" href="{{ bs.link_wrapper }}" aria-label="{{ bs.screen_reader_text | append: ' read more' }}" ></a>
          {% endif %}
          <div class="banner__item-image">
            {% if bs.background_image_desktop != blank %}
              {% render 'c-responsive-image', {
              image: bs.background_image_desktop,
                image_class: 'image-css-class',
                modifier: 'banner',
                wrapper_class: 'desktop-only',
                inline_ir: true,
                } %}
            {% endif %}

            {% if bs.background_image_tablet != blank %}
              {% render 'c-responsive-image', {
              image: bs.background_image_tablet,
                image_class: 'image-css-class',
                modifier: 'banner',
                wrapper_class: 'tablet-only',
                inline_ir: true,
                } %}
            {% endif %}

            {% if bs.background_image_mobile != blank %}
              {% render 'c-responsive-image', {
              image: bs.background_image_mobile,
                image_class: 'image-css-class',
                modifier: 'banner',
                wrapper_class: 'phone-only',
                inline_ir: true,
                } %}
            {% endif %}
          </div>
          <div class="banner__item-content{% if bs.mobile_stack %} banner__item-content--stack{% endif %} banner__item-content--{{ bs.content_position_horizontal_desktop }} container">
            <div class="banner__item-content__header-container">
              {% if bs.sub_heading_text != blank %}
                <div class="banner__item-content__sub-heading" style="color: {{ bs.sub_heading_color }};">
                  <p>{{ bs.sub_heading_text | newline_to_br }}</p>
                </div>
              {% endif %}
              {% if bs.heading_text != blank %}
                <div class="banner__item-content__heading" style="color: {{ bs.heading_color }};">
                  <p>{{ bs.heading_text | newline_to_br }}</p>
                </div>
              {% endif %}
            </div>
            {% if bs.body_text != blank %}
              <div class="banner__item-content__body-text" style="color: {{ bs.body_text_color }};">
                <p>{{ bs.body_text | newline_to_br }}</p>
              </div>
            {% endif %}
            {% if bs.cta_text != blank %}
              <div class="banner__item-content__cta-wrapper">
                <div>
                  <a
                    href="{{ bs.cta_url }}"
                    class="banner__item-content__cta banner__item-content__cta--primary"
                  >
                    <span>
                      {{ bs.cta_text }}
                    </span>
                  </a>
                </div>
                {% if bs.secondary_cta != blank %}
                  <div>
                    <a
                      href="{{ bs.cta_url_2 }}"
                      class="banner__item-content__cta banner__item-content__cta--secondary"
                    >
                      <span>
                        {{ bs.cta_text_2 }}
                      </span>
                    </a>
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
        <style>
          #block-{{ block.id }} {
            --overlay-background-color: {{ hex_to_rgba }};
          }
        </style>
      </div>
    </swiper-slide>
  {% endfor %}
</swiper-container>


{% schema %}
{
  "name": "Banner Carousel",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 0,
      "max": 12,
      "step": 3,
      "label": "Autoplay delay",
      "info": "Set to 0 to disable autoplay",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "Banner",
      "name": "Banner",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_page_hero",
          "label": "Is banner a page hero?"
        },
        {
          "type": "image_picker",
          "id": "background_image_desktop",
          "label": "Background Image (Desktop)",
          "info": "Format: JPG or GIF. Recommended dimensions: width: 3840px; height: 1371px;"
        },
        {
          "type": "image_picker",
          "id": "background_image_tablet",
          "label": "Background Image (Tablet)",
          "info": "Format: JPG or GIF. Recommended dimensions: width: 3840px; height: 1371px;"
        },
        {
          "type": "image_picker",
          "id": "background_image_mobile",
          "label": "Background Image (Mobile)",
          "info": "Format: JPG or GIF. Recommended dimensions: width: 750px; height: 1075px;"
        }, {
          "type": "color",
          "id": "image_overlay_color",
          "label": "Image Overlay Color",
          "info": "Optional image overlay to enable text readability.",
          "default": "#000"
        }, {
          "type": "range",
          "id": "image_overlay_opacity",
          "min": 0,
          "max": 1,
          "step": 0.1,
          "unit": "pts",
          "label": "Image Overlay Opacity",
          "info": "Sets the opacity of the overlay. Range 0-1. Increments by 0.1.",
          "default": 0
        }, {
          "type": "header",
          "content": "Content"
        }, {
          "type": "url",
          "id": "link_wrapper",
          "label": "Wraps Image with Link"
        }, {
          "type": "checkbox",
          "id": "mobile_stack",
          "label": "Mobile Text Stack",
          "info": "Used to stack content block (sub-heading, heading, body text, CTA) above image instead of overlaying image on mobile.",
          "default": false
        }, {
          "type": "color",
          "id": "mobile_stack_color",
          "label": "Mobile Text Stack Background Color",
          "info": "Optional background color on content block when Mobile Text Stack option is selected",
          "default": "#fff"
        }, {
          "type": "select",
          "id": "content_position_horizontal_desktop",
          "label": "Desktop Horizontal Content Position",
          "options": [
            {
              "value": "left",
              "label": "Align Left"
            }, {
              "value": "center",
              "label": "Align Center"
            }, {
              "value": "right",
              "label": "Align Right"
            }
          ],
          "default": "left",
          "info": "Used to horizontally align the content block (sub-heading, heading, body text, CTA) left, center, or right in the banner on desktop."
        }, {
          "type": "select",
          "id": "content_position_vertical_desktop",
          "label": "Desktop Vertical Content Position",
          "options": [
            {
              "value": "start",
              "label": "Align Top"
            }, {
              "value": "center",
              "label": "Align Middle"
            }, {
              "value": "end",
              "label": "Align Bottom"
            }
          ],
          "default": "center",
          "info": "Used to vertically align the content block (sub-heading, heading, body text, CTA) top, middle, or bottom in the banner on desktop."
        }, {
          "type": "select",
          "id": "content_position_vertical_mobile",
          "label": "Mobile Vertical Content Position",
          "options": [
            {
              "value": "start",
              "label": "Align Top"
            }, {
              "value": "center",
              "label": "Align Middle"
            }, {
              "value": "end",
              "label": "Align Bottom"
            }
          ],
          "default": "start",
          "info": "Used to vertically align the content block (sub-heading, heading, body text, CTA) top, middle, or bottom in the banner on mobile."
        }, {
          "type": "header",
          "content": "Sub-Heading"
        }, {
          "type": "textarea",
          "id": "sub_heading_text",
          "label": "Sub-Heading Text",
          "default": "Sub-Heading text here",
          "info": "Descriptive keyword or phrase placed above the main heading. Return/enter can be used to create line breaks in content."
        }, {
          "type": "textarea",
          "id": "screen_reader_text",
          "label": "Screen Reader Text",
          "default": "Sub-Heading text here",
          "info": "Descriptive keyword or phrase for screen readers. Return/enter can be used to create line breaks in content."
        }, {
          "type": "select",
          "id": "sub_heading_position_desktop",
          "label": "Sub-Heading Position (Desktop)",
          "options": [
            {
              "value": "left",
              "label": "Align Left"
            }, {
              "value": "center",
              "label": "Align Center"
            }, {
              "value": "right",
              "label": "Align Right"
            }
          ],
          "default": "left",
          "info": "Used to align the sub-heading left, right, or center in the banner on desktop."
        }, {
          "type": "select",
          "id": "sub_heading_position_mobile",
          "label": "Sub-Heading Position (Mobile)",
          "options": [
            {
              "value": "left",
              "label": "Align Left"
            }, {
              "value": "center",
              "label": "Align Center"
            }, {
              "value": "right",
              "label": "Align Right"
            }
          ],
          "default": "left",
          "info": "Used to align the sub-heading left, right, or center in the banner on mobile."
        }, {
          "type": "color",
          "id": "sub_heading_color",
          "label": "Sub-Heading Color",
          "default": "#000"
        }, {
          "type": "header",
          "content": "Heading"
        }, {
          "type": "textarea",
          "id": "heading_text",
          "label": "Heading Text",
          "default": "Heading text here",
          "info": "Return/enter can be used to create line breaks in content."
        }, {
          "type": "select",
          "id": "heading_position_desktop",
          "label": "Heading Position (Desktop)",
          "options": [
            {
              "value": "left",
              "label": "Align Left"
            }, {
              "value": "center",
              "label": "Align Center"
            }, {
              "value": "right",
              "label": "Align Right"
            }
          ],
          "default": "left",
          "info": "Used to align the heading left, right, or center in the banner on desktop."
        }, {
          "type": "select",
          "id": "heading_position_mobile",
          "label": "Heading Position (Mobile)",
          "options": [
            {
              "value": "left",
              "label": "Align Left"
            }, {
              "value": "center",
              "label": "Align Center"
            }, {
              "value": "right",
              "label": "Align Right"
            }
          ],
          "default": "left",
          "info": "Used to align the heading left, right, or center in the banner on mobile."
        }, {
          "type": "color",
          "id": "heading_color",
          "label": "Heading Color",
          "default": "#000"
        }, {
          "type": "header",
          "content": "Body Text"
        }, {
          "type": "textarea",
          "id": "body_text",
          "label": "Body Text",
          "default": "Body text here",
          "info": "Return/enter can be used to create line breaks in content."
        }, {
          "type": "select",
          "id": "body_text_position_desktop",
          "label": "Body Text Position (Desktop)",
          "options": [
            {
              "value": "left",
              "label": "Align Left"
            }, {
              "value": "center",
              "label": "Align Center"
            }, {
              "value": "right",
              "label": "Align Right"
            }
          ],
          "default": "left",
          "info": "Used to align the body text left, right, or center in the banner."
        }, {
          "type": "select",
          "id": "body_text_position_mobile",
          "label": "Body Text Position (Mobile)",
          "options": [
            {
              "value": "left",
              "label": "Align Left"
            }, {
              "value": "center",
              "label": "Align Center"
            }, {
              "value": "right",
              "label": "Align Right"
            }
          ],
          "default": "left",
          "info": "Used to align the body text left, right, or center in the banner."
        }, {
          "type": "color",
          "id": "body_text_color",
          "label": "Body Text Color",
          "default": "#000"
        }, {
          "type": "range",
          "label": "Body Text Max Width",
          "id": "body_max_width",
          "min": 0,
          "max": 500,
          "step": 5,
          "default": 500
        }, {
          "type": "radio",
          "id": "max_width_unit",
          "label": "Max Width Unit",
          "options": [
            {
              "value": "%",
              "label": "Percentage"
            }, {
              "value": "px",
              "label": "Pixel"
            }
          ],
          "default": "px"
        }, {
          "type": "header",
          "content": "CTA"
        }, {
          "type": "text",
          "id": "cta_text",
          "label": "CTA Text",
          "default": "Default CTA text"
        }, {
          "type": "text",
          "id": "cta_url",
          "label": "CTA URL",
          "default": "https://moma-design-store.myshopify.com"
        }, {
          "type": "select",
          "id": "cta_position_desktop",
          "label": "CTA Position (Desktop)",
          "options": [
            {
              "value": "left",
              "label": "Align Left"
            }, {
              "value": "center",
              "label": "Align Center"
            }, {
              "value": "right",
              "label": "Align Right"
            }
          ],
          "default": "left",
          "info": "Used to align the cta button left, right, or center in the banner."
        }, {
          "type": "select",
          "id": "cta_position_mobile",
          "label": "CTA Position (Mobile)",
          "options": [
            {
              "value": "flex-start",
              "label": "Align Left"
            }, {
              "value": "center",
              "label": "Align Center"
            }, {
              "value": "flex-end",
              "label": "Align Right"
            }
          ],
          "default": "flex-start",
          "info": "Used to align the cta button left, right, or center in the banner."
        }, {
          "type": "header",
          "content": "Static CTA Options"
        }, {
          "type": "select",
          "id": "static_cta_style",
          "label": "Static CTA Style",
          "options": [
            {
              "value": "transparent_background",
              "label": "Transparent Background"
            }, {
              "value": "solid_background",
              "label": "Solid Background"
            }
          ],
          "default": "solid_background"
        }, {
          "type": "color",
          "id": "cta_static_background_color",
          "label": "CTA Background Color",
          "default": "#FFF"
        }, {
          "type": "color",
          "id": "cta_static_text_color",
          "label": "CTA Text Color",
          "default": "#000"
        }, {
          "type": "header",
          "content": "Hover CTA Options"
        }, {
          "type": "select",
          "id": "hover_cta_style",
          "label": "Hover CTA Style",
          "options": [
            {
              "value": "transparent_background",
              "label": "Transparent Background"
            }, {
              "value": "solid_background",
              "label": "Solid Background"
            }
          ],
          "default": "solid_background"
        }, {
          "type": "color",
          "id": "cta_hover_background_color",
          "label": "CTA Background Color",
          "default": "#FFF"
        }, {
          "type": "color",
          "id": "cta_hover_text_color",
          "label": "CTA Text Color",
          "default": "#000"
        }, {
          "type": "header",
          "content": "Secondary CTA (optional)"
        }, {
          "type": "checkbox",
          "id": "secondary_cta",
          "label": "Enable the Secondary CTA",
          "default": false
        }, {
          "type": "text",
          "id": "cta_text_2",
          "label": "Secondary CTA Text",
          "default": "Default CTA text"
        }, {
          "type": "url",
          "id": "cta_url_2",
          "label": "Secondary CTA URL"
        }, {
          "type": "header",
          "content": "Secondary Static CTA Options"
        }, {
          "type": "select",
          "id": "static_cta_style_2",
          "label": "Secondary Static CTA Style",
          "options": [
            {
              "value": "transparent_background",
              "label": "Transparent Background"
            }, {
              "value": "solid_background",
              "label": "Solid Background"
            }
          ],
          "default": "solid_background"
        }, {
          "type": "color",
          "id": "cta_static_background_color_2",
          "label": "Secondary CTA Background Color",
          "default": "#FFF"
        }, {
          "type": "color",
          "id": "cta_static_text_color_2",
          "label": "Secondary CTA Text Color",
          "default": "#000"
        }, {
          "type": "header",
          "content": "Secondary Hover CTA Options"
        }, {
          "type": "select",
          "id": "hover_cta_style_2",
          "label": "Secondary Hover CTA Style",
          "options": [
            {
              "value": "transparent_background",
              "label": "Transparent Background"
            }, {
              "value": "solid_background",
              "label": "Solid Background"
            }
          ],
          "default": "solid_background"
        }, {
          "type": "color",
          "id": "cta_hover_background_color_2",
          "label": "Secondary CTA Background Color",
          "default": "#FFF"
        }, {
          "type": "color",
          "id": "cta_hover_text_color_2",
          "label": "Secondary CTA Text Color",
          "default": "#000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Banner Carousel"
    }
  ]
}
{% endschema %}
