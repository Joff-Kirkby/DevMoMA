{%- comment -%}
  2-Up + Text Section
{%- endcomment -%}

{% render 'c-two-up-and-text', {
  section: section
} %}

{% schema %}
  {
    "name": "2-Up + Text",
    "settings": [
      {
        "type": "header",
        "content": "2-Up + Text"
      },
      {
        "type": "text",
        "id": "headline",
        "label": "Headline"
      },
      {
        "type": "select",
        "id": "text_block_alignment",
        "label": "Text Block Alignment",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "left"
      },
      {
        "type": "richtext",
        "id": "text",
        "label": "Text"
      },
      {
        "type": "text",
        "id": "cta_text",
        "label": "CTA Text"
      },
      {
        "type": "url",
        "id": "cta_url",
        "label": "URL",
        "info": "For CTA/Image"
      },
      {
        "type": "header",
        "content": "Static CTA Options"
      },
      {
        "type": "select",
        "id": "static_cta_style",
        "label": "Static CTA Style",
        "options": [
          {
            "value": "transparent_background",
            "label": "Transparent Background"
          },
          {
            "value": "solid_background",
            "label": "Solid Background"
          }
        ],
        "default": "solid_background"
      },
      {
        "type": "color",
        "id": "cta_static_background_color",
        "label": "CTA Background Color",
        "default": "#000"
      },
      {
        "type": "color",
        "id": "cta_static_text_color",
        "label": "CTA Text Color",
        "default": "#FFF"
      },
      {
        "type": "header",
        "content": "Hover CTA Options"
      },
      {
        "type": "select",
        "id": "hover_cta_style",
        "label": "Hover CTA Style",
        "options": [
          {
            "value": "transparent_background",
            "label": "Transparent Background"
          },
          {
            "value": "solid_background",
            "label": "Solid Background"
          }
        ],
        "default": "transparent_background"
      },
      {
        "type": "color",
        "id": "cta_hover_background_color",
        "label": "CTA Background Color",
        "default": "#FFF"
      },
      {
        "type": "color",
        "id": "cta_hover_text_color",
        "label": "CTA Text Color",
        "default": "#000"
      },
      {
        "type": "paragraph",
        "content": "-------------------------"
      },
      {
        "type": "text",
        "id": "anchor",
        "label": "Anchor",
        "info": "Used to directly link to this section"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image",
        "info": "Format: JPG. Recommended dimensions: width: 820px; height: 980px;"
      },
      {
        "type": "image_picker",
        "id": "image_2",
        "label": "Image 2",
        "info": "Format: JPG. Recommended dimensions: width: 820px; height: 980px;"
      }
    ],
    "presets": [
      {
        "name": "2-Up + Text"
      }
    ]
  }
{% endschema %}
